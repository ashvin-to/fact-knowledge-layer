# ── Extractor / Verifier Role (Primary: Local llama-server) ───────────────
# Fast per-page extraction with ZERO API costs & ZERO rate limits!
EXTRACTOR_LLM_BASE_URL=http://localhost:8080/v1
EXTRACTOR_LLM_API_KEY=none
EXTRACTOR_LLM_MODEL=local-model

# Fallback for Extractor if local server is stopped:
FALLBACK_EXTRACTOR_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_EXTRACTOR_LLM_API_KEY=gsk_...
FALLBACK_EXTRACTOR_LLM_MODEL=qwen/qwen3.8-27b

# ── Reasoner Role (Primary: Groq LPU, Fallback: OpenRouter, Tertiary: Local)
# High-speed reasoning on candidate pairs
REASONER_LLM_BASE_URL=https://api.groq.com/openai/v1
REASONER_LLM_API_KEY=gsk_...
REASONER_LLM_MODEL=qwen/qwen3.8-27b

# Secondary fallback when Groq hits 429 rate limit:
FALLBACK_REASONER_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_REASONER_LLM_API_KEY=sk-or-v1-...
FALLBACK_REASONER_LLM_MODEL=minimax/minimax-m3:free

# Tertiary local fallback if cloud providers hit rate limits:
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=local-model

# ── Comparison & Matching ──────────────────────────────────────────────────
MATCH_SIMILARITY_THRESHOLD=0.6

# ── SQLite & Storage ───────────────────────────────────────────────────────
DB_PATH=facts.db
STORAGE_DIR=storage