# ==============================================================================
# FACT KNOWLEDGE LAYER CONFIGURATION
# Choose ONE of the setup presets below (Cloud API or Local Ollama / Llama.cpp)
# ==============================================================================

# ------------------------------------------------------------------------------
# PRESET 1: CLOUD API (FASTEST & RECOMMENDED FOR EVALUATION)
# Get a free API key instantly at https://console.groq.com/keys
# ------------------------------------------------------------------------------
# EXTRACTOR_LLM_BASE_URL=https://api.groq.com/openai/v1
# EXTRACTOR_LLM_API_KEY=gsk_your_groq_api_key_here
# EXTRACTOR_LLM_MODEL=llama-3.3-70b-versatile
#
# REASONER_LLM_BASE_URL=https://api.groq.com/openai/v1
# REASONER_LLM_API_KEY=gsk_your_groq_api_key_here
# REASONER_LLM_MODEL=llama-3.3-70b-versatile
#
# FALLBACK_REASONER_LLM_BASE_URL=https://openrouter.ai/api/v1
# FALLBACK_REASONER_LLM_API_KEY=sk-or-v1-...
# FALLBACK_REASONER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ------------------------------------------------------------------------------
# PRESET 2: OLLAMA (EASIEST LOCAL SETUP - ZERO API KEYS)
# 1. Install Ollama: https://ollama.com
# 2. Run: ollama run qwen2.5:3b (or ollama run qwen2.5:7b)
# ------------------------------------------------------------------------------
# EXTRACTOR_LLM_BASE_URL=http://localhost:11434/v1
# EXTRACTOR_LLM_API_KEY=ollama
# EXTRACTOR_LLM_MODEL=qwen2.5:3b
#
# REASONER_LLM_BASE_URL=http://localhost:11434/v1
# REASONER_LLM_API_KEY=ollama
# REASONER_LLM_MODEL=qwen2.5:3b

# ------------------------------------------------------------------------------
# PRESET 3: LLAMA.CPP / VLLM / LOCAL OPENAI-COMPATIBLE SERVER
# ------------------------------------------------------------------------------
EXTRACTOR_LLM_BASE_URL=http://localhost:8080/v1
EXTRACTOR_LLM_API_KEY=none
EXTRACTOR_LLM_MODEL=local-model

REASONER_LLM_BASE_URL=http://localhost:8080/v1
REASONER_LLM_API_KEY=none
REASONER_LLM_MODEL=local-model

# ------------------------------------------------------------------------------
# SYSTEM & STORAGE SETTINGS
# ------------------------------------------------------------------------------
MATCH_SIMILARITY_THRESHOLD=0.6
DB_PATH=facts.db
STORAGE_DIR=storage